{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && node build-server.mjs",
    "start": "node dist/server.cjs",
    "print-agent": "node ./node_modules/tsx/dist/cli.mjs print-agent/src/main.ts",
    "print-agent:token": "node ./node_modules/tsx/dist/cli.mjs scripts/create-printer-agent-token.ts",
    "test:print-agent": "node ./node_modules/tsx/dist/cli.mjs print-agent/test/agent.test.ts",
    "postinstall": "prisma generate",
    "test": "node ./node_modules/tsx/dist/cli.mjs server/test/auth.test.ts",
    "test:scenarios": "node ./node_modules/tsx/dist/cli.mjs server/test/e2e_scenarios.test.ts",
    "test:printing": "node ./node_modules/tsx/dist/cli.mjs server/test/printer_routing.test.ts && node ./node_modules/tsx/dist/cli.mjs server/test/print_security.test.ts",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "6.4.1",
    "@react-three/fiber": "^9.8.2",
    "@shadergradient/react": "^2.4.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "camera-controls": "^3.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nepali-datetime": "^2.0.0",
    "nodemailer": "^9.1.0",
    "prisma": "6.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "6.4.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
