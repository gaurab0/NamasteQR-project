# Server & Environment Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET="serveflow_super_secure_jwt_secret_change_in_production_2026"
SESSION_EXPIRY_DAYS=7
BCRYPT_SALT_ROUNDS=10

# WhatsApp OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# Development OTP Mode
DEV_OTP_MODE=true

# WhatsApp Business API Providers (meta, twilio, mock)
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Twilio Alternative (if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optional: Pre-approved Twilio Content Template SID (starts with HX)
TWILIO_CONTENT_SID=""

# Email Service (for Password Reset)
EMAIL_PROVIDER=mock
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="no-reply@serveflow.app"

# App URL
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""

